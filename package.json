    "expo-constants": "~57.0.18",
    "expo-dev-client": "~57.0.19",
    "expo-font": "~57.0.4",
    "expo-haptics": "~57.0.3",
    "expo-image-manipulator": "~57.0.20",
    "expo-image-picker": "~57.0.17",
    "expo-linking": "~57.0.10",
    "expo-location": "~57.0.20",
    "expo-router": "~57.0.21",
    "expo-splash-screen": "~57.0.9",
    "expo-status-bar": "~57.0.1",
    "expo-symbols": "~57.0.3",
    "expo-task-manager": "~57.0.21",
    "expo-web-browser": "~57.0.3",
    "fractional-indexing": "^3.2.0",
    "lucide-react-native": "^1.45.0",
    "nativewind": "^4.2.6",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-reanimated": "4.5.1",
    "react-native-redash": "^18.1.5",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-svg": "15.15.4",
    "react-native-wagmi-charts": "^3.0.1",
    "react-native-web": "~0.21.0",
    "react-native-worklets": "0.10.1",
    "tailwindcss": "^3.4.19",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@types/jest": "29.5.14",
    "@types/react": "~19.2.2",
    "babel-preset-expo": "^57.0.11",
    "jest": "~29.7.0",
    "jest-expo": "~57.0.5",
    "jiti": "^1",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "test": "node --experimental-strip-types --test lib/elevationMotion.test.ts lib/format.test.ts lib/photoEncode.test.ts lib/ranking.test.ts && jest --ci",
    "start": "expo start --port 43127",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web --port 43127",
    "build:dev": "eas build --profile development",
    "build:preview": "eas build --profile preview",
    "build:prod": "eas build --profile production",
    "submit:ios": "eas submit --platform ios --profile production",
    "submit:android": "eas submit --platform android --profile production",
    "typecheck": "tsc --noEmit"
  },
  "jest": {
    "preset": "jest-expo",
    "testPathIgnorePatterns": [
      "/node_modules/",
      "<rootDir>/lib/"
    ],
    "transformIgnorePatterns": [
      "node_modules/(?!((jest-)?react-native|@react-native(-community)?)|expo(nent)?|@expo(nent)?/.*|@expo-google-fonts/.*|react-navigation|@react-navigation/.*|@sentry/react-native|native-base|react-native-svg|fractional-indexing)"
    ]
  },
  "private": true,
  "description": "Utilitarian hiking log and pairwise trail ranking for outdoorsy tech people",
  "keywords": "[\"expo\",\"react-native\",\"hiking\",\"trails\",\"elo\",\"nativewind\"]"
}
