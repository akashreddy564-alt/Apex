{
  "expo": {
    "name": "Apex",
    "slug": "apex",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "apex",
    "userInterfaceStyle": "dark",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.apex.trails"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#09090B",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.apex.trails",
      "permissions": [
        "android.permission.POST_NOTIFICATIONS"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "./plugins/withRecordingNotification.js",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Apex records your hike's route while you're recording, including with the screen off. Your location isn't used at any other time.",
          "locationAlwaysAndWhenInUsePermission": "Apex records your hike's route while you're recording, including with the screen off. Your location isn't used at any other time.",
          "locationAlwaysPermission": "Apex records your hike's route while you're recording, including with the screen off. Your location isn't used at any other time.",
          "motionUsagePermission": false,
          "isIosBackgroundLocationEnabled": true,
          "isAndroidBackgroundLocationEnabled": false,
          "isAndroidForegroundServiceEnabled": true
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Apex attaches photos to your hike log.",
          "cameraPermission": "Apex takes photos for your hike log.",
          "microphonePermission": false
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "resizeMode": "contain",
          "backgroundColor": "#09090B"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
