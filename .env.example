# Optional — leave unset to use local mock trails + Zustand persistence
EXPO_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Mapbox public token (pk.…). Ships in the app; restrict it to your bundle id in the Mapbox dashboard.
EXPO_PUBLIC_MAPBOX_TOKEN=pk.your-public-token
# Mapbox secret downloads token (sk.…). Build-time only; never prefix with EXPO_PUBLIC_.
MAPBOX_DOWNLOADS_TOKEN=sk.your-secret-token

# Local-only iOS bundle id for Personal Team signing. Never commit a real value.
APP_BUNDLE_ID=
